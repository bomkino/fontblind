def infer_variable_lane(axes: Sequence[Mapping[str, object]]) -> str:
    tags = tuple(str(axis.get("tag", "")) for axis in axes)
    lanes = {
        ("wght",): LANE_VARIABLE_WGHT,
        ("wdth",): LANE_VARIABLE_WDTH,
        ("wght", "wdth"): LANE_VARIABLE_2D,
    }
    try:
        return lanes[tags]
    except KeyError as exc:
        raise ValueError("FontBlind produced an unsupported variable-axis model") from exc


def expected_checks(lane: str, *, public: bool) -> frozenset[str]:
    if lane not in _BASE_CHECKS:
        raise ValueError("FontBlind worker returned an unknown result lane")
